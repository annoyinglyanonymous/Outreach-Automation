# Copy to .env and fill in. Real environment variables always override
# .env, so a deployed container configured via its platform ignores this
# file entirely. .env is gitignored — never commit credentials.

# ----- required at startup ---------------------------------------------

# Supabase SESSION pooler (port 5432), not the transaction pooler on 6543:
# the claim queries hold locks across statements within a transaction.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Shared secret required on POST /enrich/run, POST /scrape/run, GET /stats.
API_KEY=

# Tier-1 enrichment provider.
APOLLO_API_KEY=

# ----- required before /scrape/run works (503 until set) ---------------

APIFY_TOKEN=
# Cookieless actor only: actors that need a LinkedIn session cookie put
# the sending accounts at ban risk. "user/actor-name" or alphanumeric id.
APIFY_ACTOR_ID=
# The actor input key that carries the URL array, and the dataset item
# keys tried when matching results back to contacts — both actor-specific.
#APIFY_INPUT_KEY=profileUrls
#APIFY_URL_FIELDS=url,profileUrl,linkedinUrl,inputUrl,publicUrl
# Extra actor input merged into the run payload, as a JSON object.
#APIFY_EXTRA_INPUT=

# ----- required before /draft/run works (503 until set) ----------------

# Drafting vendor: "n8n" (an n8n webhook fronting the org's OpenAI
# credential — import docs/n8n-llm-workflow.json, pick the credential,
# ACTIVATE it, paste the production URL below), "groq", or "anthropic".
# All implement the same Drafter protocol, so switching is config only.
#DRAFT_PROVIDER=groq
#N8N_LLM_URL=
GROQ_API_KEY=
# Empty = the provider's own default (groq: openai/gpt-oss-120b,
# anthropic: claude-opus-4-8).
#DRAFT_MODEL=
#DRAFT_EFFORT=high
# Keep prompt+max_tokens under your Groq tier's TPM limit (free tier:
# 8000/request) — the API rejects requests that RESERVE more than that.
# But not too low either: gpt-oss reasons before answering, and a tight
# budget yields empty generations (400 json_validate_failed).
#DRAFT_MAX_TOKENS=4000
#DRAFT_BATCH_SIZE=25
#DRAFT_PROFILE_CHAR_LIMIT=6000
# Only needed when DRAFT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ----- AI verification (between scrape and draft) ----------------------

# An LLM judges whether the matched LinkedIn profile really belongs to the
# contact; a wrong/unsure match is rejected to the email-only template
# path. Reuses the drafting LLM route (DRAFT_PROVIDER / N8N_LLM_URL); needs
# n8n or groq (anthropic has no complete_json). Off makes the stage a no-op
# and the manual /ui/verify page the path — and scrape then nudges draft
# directly. Only works when DRAFT_PROVIDER is n8n or groq and its key/URL is set.
#VERIFY_ENABLED=true
#VERIFY_BATCH_SIZE=25

# ----- required before /email/run works (503 until one is set) ---------

# Cold campaigns send via Smartlead (its campaign id lives on each of
# our campaigns), opted-in via Resend (needs a verified domain and the
# campaign's sender_email). One key is enough to run that consent path.
SMARTLEAD_API_KEY=
RESEND_API_KEY=
#SEND_BATCH_SIZE=25

# Schedule applied when campaign creation auto-builds the Smartlead
# campaign. Days: 1=Mon … 5=Fri. Conservative caps protect warmup.
#SMARTLEAD_SCHEDULE_TIMEZONE=America/New_York
#SMARTLEAD_SCHEDULE_DAYS=1,2,3,4,5
#SMARTLEAD_SCHEDULE_START_HOUR=09:00
#SMARTLEAD_SCHEDULE_END_HOUR=17:00
#SMARTLEAD_MAX_NEW_LEADS_PER_DAY=20
#SMARTLEAD_MIN_TIME_BTW_EMAILS=10

# ----- automation: in-process scheduler --------------------------------

# Off by default — the pipeline is fully manual (click Run, or POST the
# /run endpoints) until you set this. When true, a scheduler inside the
# app triggers the stages on an interval. Review/approval is NEVER
# automated: the email stage only sends drafts a human approved.
#SCHEDULER_ENABLED=false
#SCHEDULER_INTERVAL_MINUTES=5
# Drop 'email' to keep sending manual while enrich/scrape/verify/draft run
# unattended. Order is irrelevant — each stage claims its own queue.
#SCHEDULER_STAGES=enrich,scrape,verify,draft,email

# ----- required before the web UI (/ui) works --------------------------

# Login checks credentials against Supabase Auth (email/password
# provider); invite users via the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Signs the UI session cookie (any long random string). Rotating it
# signs everyone out.
SESSION_SECRET=
# n8n ingest webhook; the UI's CSV upload proxies to it.
N8N_INGEST_URL=
#SESSION_MAX_AGE_MINUTES=480
#CSV_MAX_BYTES=2000000

# ----- optional, defaults shown ----------------------------------------

#PROVIDER=apollo
#DB_POOL_MIN=1
#DB_POOL_MAX=5
#BATCH_SIZE=100
#MAX_PASSES=20
#STALE_CLAIM_MINUTES=15
#CACHE_MAX_AGE_DAYS=365
#CACHE_MIN_CONFIDENCE=0.70
#MIN_ACCEPT_CONFIDENCE=0.55
#APOLLO_BATCH_SIZE=10
#APOLLO_CHUNK_DELAY_SECONDS=1.0
#PROVIDER_TIMEOUT_SECONDS=60
#PROVIDER_MAX_RETRIES=4
#SCRAPE_BATCH_SIZE=50
#APIFY_MAX_ACTIVE_RUNS=3
